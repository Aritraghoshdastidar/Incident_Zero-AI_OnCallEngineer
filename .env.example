# Copy this file to .env and fill in your own key. .env is git-ignored and must never be committed.

# A free key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=your-key-here

# Optional: a second key is rotated in automatically when the first is rate-limited
# GEMINI_API_KEY_2=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
